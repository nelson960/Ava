# Protocol-v4 development configuration. The Responses settings below remain
# only for explicit offline evaluation tooling; no lesson/performance HTTP route
# consumes them. Copy this file to backend/.env only for local development.
# Never commit backend/.env.
AVA_ENVIRONMENT=development
AVA_OPENAI_API_KEY=
AVA_OPENAI_MODEL=gpt-5.6-terra
AVA_OPENAI_REASONING_EFFORT=low
AVA_OPENAI_TIMEOUT_SECONDS=20
AVA_OPENAI_MAX_RETRIES=2
AVA_OPENAI_MAX_OUTPUT_TOKENS=1200

# Protocol-v3 OpenAI Realtime. Live probes require both the explicit CLI
# confirmation and AVA_OPENAI_LIVE_TESTS_ENABLED=true.
AVA_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
AVA_OPENAI_REALTIME_CONNECT_TIMEOUT_SECONDS=15
AVA_OPENAI_REALTIME_MAX_OUTPUT_TOKENS=1200
AVA_OPENAI_LIVE_TESTS_ENABLED=false

AVA_OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
AVA_OPENAI_TTS_VOICE=marin
AVA_OPENAI_TTS_SPEED=1.0

# Candidate B timed speech. Copy the exact voice ID and model ID from the
# ElevenLabs generation metadata; do not guess them from the display name.
AVA_ELEVENLABS_API_KEY=
AVA_ELEVENLABS_VOICE_ID=
AVA_ELEVENLABS_VOICE_LABEL=Eve marry
AVA_ELEVENLABS_MODEL_ID=
# Do not set this to true until the selected voice's commercial rights have
# been checked and recorded.
AVA_ELEVENLABS_COMMERCIAL_RIGHTS_CONFIRMED=false
AVA_ELEVENLABS_OUTPUT_FORMAT=pcm_24000
AVA_ELEVENLABS_TIMEOUT_SECONDS=20
AVA_ELEVENLABS_STABILITY=0.5
AVA_ELEVENLABS_SIMILARITY_BOOST=0.75
AVA_ELEVENLABS_STYLE=0
AVA_ELEVENLABS_USE_SPEAKER_BOOST=true
AVA_ELEVENLABS_SPEED=1.0

# Offline legacy conversation-memory evaluation configuration. Production
# realtime memory uses AVA_DATABASE_URL below.
AVA_SUPABASE_URL=
AVA_SUPABASE_SERVICE_ROLE_KEY=
AVA_SUPABASE_TIMEOUT_SECONDS=10
AVA_CONTEXT_HISTORY_MAX_MESSAGES=12
AVA_CONTEXT_HISTORY_MAX_CHARACTERS=8000

# Protocol-v3 durable memory. Use the same standard PostgreSQL URL locally and
# the direct/pooler PostgreSQL URL supplied by Supabase in production. This
# local password belongs only to backend/docker-compose.memory.yml.
AVA_DATABASE_URL=postgresql://ava:ava-local-only@127.0.0.1:55432/ava
AVA_MEMORY_POOL_MIN_SIZE=1
AVA_MEMORY_POOL_MAX_SIZE=4
AVA_MEMORY_POOL_TIMEOUT_SECONDS=5
AVA_MEMORY_WEEKLY_RETENTION_DAYS=56

# Required in production. Generate a random secret; do not reuse an API key.
AVA_SAFETY_HASH_SECRET=

# The current v1 server is deliberately loopback-only in development.
AVA_DEVELOPMENT_ALLOWED_HOSTS=127.0.0.1,::1,localhost,testclient
