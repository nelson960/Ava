  "authoringContractVersion": "ava-svg-authoring-contract-v1",
  "documentContract": {
    "canonicalBytes": "exactUtf8ProviderOutput",
    "externalResources": false,
    "resolutionIndependentViewBox": true,
    "scripts": false
  },
  "identifierContract": {
    "appliesTo": [
      "bindingId",
      "elementId",
      "revealId",
      "targetId"
    ],
    "maximumCharacters": 96,
    "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,95}$"
  },
  "interactionEnvironment": {
    "clientExpandsCompactTargets": true,
    "defaultMinimumTargetPoints": 44,
    "manifestRequiredForAuthority": true
  },
  "interactionContract": {
    "bindingElementRequiresId": true,
    "bindingCountByMode": {
      "explore": {
        "maximum": 32,
        "minimum": 1
      },
      "none": {
        "maximum": 0,
        "minimum": 0
      },
      "select": {
        "maximum": 32,
        "minimum": 1
      },
      "steps": {
        "maximum": 12,
        "minimum": 2
      }
    },
    "bindingId": {
      "required": true,
      "syntax": "identifierContract",
      "unique": true
    },
    "metadataRequiresBinding": [
      "data-ava-reveal",
      "data-ava-step",
      "data-ava-target"
    ],
    "modeRules": {
      "explore": {
        "bindings": "required",
        "reveals": "optionalDocumentLocalIds",
        "stepIndexes": "forbidden"
      },
      "none": {
        "bindings": "forbidden",
        "reveals": "forbidden",
        "stepIndexes": "forbidden"
      },
      "select": {
        "bindings": "required",
        "reveals": "forbidden",
        "stepIndexes": "forbidden"
      },
      "steps": {
        "bindings": "required",
        "reveals": "forbidden",
        "stepIndexes": "requiredUniqueContiguousFromOne"
      }
    },
    "revealIds": {
      "mustResolveToDocumentElementIds": true,
      "syntax": "identifierContract"
    },
    "stepIndexes": "uniqueContiguousFromOne",
    "targetId": {
      "explicitMustResolveToDocumentElementId": true,
      "omittedDefaultsToBindingElement": true,
      "syntax": "identifierContract"
    }
  },
  "limits": {
    "attributeCharacters": 131072,
    "attributes": 3072,
    "attributesPerElement": 64,
    "backgroundCharacters": 96,
    "bindingLabelCharacters": 160,
    "bindings": 32,
    "bytes": 393216,
    "descriptionCharacters": 800,
    "depth": 32,
    "elements": 384,
    "expandedElements": 2048,
    "filterPrimitives": 48,
    "manifestBytes": 65536,
    "pathCharacters": 96000,
    "pathCommands": 6000,
    "referenceDepth": 20,
    "references": 768,
    "textCharacters": 24000,
    "titleCharacters": 160,
    "transformOperations": 768,
    "viewBoxExtent": 10000.0
  },
  "manifestVersion": "ava-svg-manifest-v2",
  "referencePolicy": {
    "allowedNamespaces": [
      "unqualified",
      "http://www.w3.org/2000/svg",
      "http://www.w3.org/1999/xlink",
      "http://www.w3.org/XML/1998/namespace"
    ],
    "documentLocalFragmentsOnly": true,
    "externalUrlsAllowed": false,
    "finalReferencesMustResolve": true,
    "referenceAttributes": [
      "clip-path",
      "fill",
      "filter",
      "href",
      "marker-end",
      "marker-mid",
      "marker-start",
      "mask",
      "stroke"
    ]
